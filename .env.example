# 로컬 개발: 네이티브 PostgreSQL 또는 Docker Postgres
# 운영 배포: Supabase(또는 다른 관리형 Postgres) 프로젝트의 Connection string 그대로 사용 가능
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/scm_inventory?schema=public"

# openssl rand -base64 32 로 생성 권장
AUTH_SECRET="change-me"
NEXTAUTH_URL="http://localhost:3000"
